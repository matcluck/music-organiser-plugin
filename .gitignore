# Python environments and generated bytecode
.venv*/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/

# Local configuration and credentials
.env
.env.*
!.env.example
*.key
*.pem

# Runtime work and run evidence
.artifact-work/
.runtime/
artifacts/*
!artifacts/README.md
skills/*/artifacts/*
!skills/*/artifacts/README.md
legacy/
to-analyse.md
*.log

# Audio, DJ databases, caches, and model payloads must stay outside Git
*.mp3
*.m4a
*.wav
*.flac
*.aif
*.aiff
*.ogg
*.wma
*.djayMetadata
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite-shm
*.sqlite-wal
*.gguf
*.xlsx

# The only audio allowed in Git is the reviewed CC0 test-fixture set.
!tests/fixtures/audio/
!tests/fixtures/audio/*.ogg
!skills/music-organiser/tests/fixtures/audio/
!skills/music-organiser/tests/fixtures/audio/*.ogg

# OS/editor noise
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.tmp
